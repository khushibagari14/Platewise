# Existing Platewise services
GEMINI_API_KEY=
# Optional backup key. A separate Google project has independent quota.
GEMINI_API_KEY_FALLBACK=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Dodo Payments (use test mode while developing)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/checkout/success

# Supabase (server-only; never use NEXT_PUBLIC_ for the secret)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service-role key can be used instead of SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=
